# ========================================================================
# 🏠 KSIT MOBILE PRODUCTION CONFIGURATION
# ========================================================================

# Application Configuration
APP_NAME=e-menu-client
EXTERNAL_PORT=9001
PORT=3002
PM2_STARTUP=true
SERVER_IP=localhost

# ========================================================================
# 🔐 Git Configuration - GitHub with Personal Access Token
# ========================================================================
GIT_USERNAME=Phatmenghor
GIT_PASSWORD=
GIT_REPO_URL=https://github.com/Phatmenghor/menu-scanner-frontend-owner.git
GIT_BRANCH=development

# ========================================================================
# 🌐 Next.js Environment Variables
# ========================================================================
NODE_ENV=production
NEXT_PUBLIC_NODE_ENV=production

# ========================================================================
# 🔗 API Configuration - NGINX PROXY SETUP
# Frontend calls: http://localhost:9001/api/* → nginx → backend:7000
# ========================================================================

NEXT_PUBLIC_TELEGRAM_BOT_NAME=CambodiaEMenuBot
NEXT_PUBLIC_TELEGRAM_BOT_ID=8464259107
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBm9cuaxspSEfAIT3PKYa1naawr8SJ0zA8
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL_IMAGE=http://localhost:8080

# ========================================================================
# ⚡ Performance Settings
# ========================================================================
NODE_OPTIONS=--max_old_space_size=1024
ENABLE_HOT_RELOAD=false
ENABLE_SOURCE_MAPS=false

# ========================================================================
# 🔧 Build Configuration
# ========================================================================
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# ========================================================================
# 📊 Logging Configuration
# ========================================================================
LOG_LEVEL=info
DEBUG_MODE=false

# ========================================================================
# 🛡️ Security Configuration
# ========================================================================
SECURE_COOKIES=true
TRUST_PROXY=true

# ========================================================================
# 📱 Application URLs (for reference)
# ========================================================================
# Frontend:    http://localhost:9001
# Backend:     http://localhost:8080
# Swagger:     http://localhost:8080/swagger-ui/swagger-ui/index.html
# API Flow:    Frontend → 9001/api/* → nginx proxy → 8080/api/*
# Images:      Frontend → 9001/uploads/* → nginx proxy → 8080/uploads/*
# ========================================================================